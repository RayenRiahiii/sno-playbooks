---
interfaces:
  - name: {{ sno_interface_name }}
    type: ethernet
    state: up
    ipv4:
      enabled: true
      dhcp: false
      address:
        - ip: {{ sno_ip_address }}
          prefix-length: {{ sno_prefix_length }}
    ipv6:
      enabled: false
dns-resolver:
  config:
    server:
{% for dns_server in sno_dns_servers %}
      - {{ dns_server }}
{% endfor %}
routes:
  config:
    - destination: 0.0.0.0/0
      next-hop-address: {{ sno_gateway }}
      next-hop-interface: {{ sno_interface_name }}
      table-id: 254

